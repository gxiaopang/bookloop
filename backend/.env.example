APP_ENV=development
HTTP_ADDR=:8080
TRUSTED_PROXIES=127.0.0.1
LOG_LEVEL=debug

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bookloop
DB_USER=bookloop
DB_PASSWORD=replace-with-a-local-password
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=bookloop
RABBITMQ_PASSWORD=replace-with-a-local-rabbitmq-password
RABBITMQ_VHOST=/

JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_ISSUER=bookloop
JWT_EXPIRES_IN=15m
BCRYPT_COST=12

# Alibaba DirectMail Hangzhou: smtpdm.aliyun.com:465 (implicit TLS).
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_PREFIX=/uploads/
UPLOAD_MAX_BYTES=10485760

ORDER_RESERVATION_TIMEOUT=15m
IDEMPOTENCY_PROCESSING_TTL=30s
IDEMPOTENCY_RESULT_TTL=24h
IDEMPOTENCY_ALLOW_DEGRADED=true
