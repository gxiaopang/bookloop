APP_ENV=development
LOG_LEVEL=info

BOOKLOOP_BIND_ADDRESS=127.0.0.1
BOOKLOOP_HTTP_PORT=8088

MYSQL_DATABASE=bookloop
MYSQL_USER=bookloop
MYSQL_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

REDIS_PASSWORD=replace-with-a-local-redis-password
REDIS_MAXMEMORY=128mb

JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_ISSUER=bookloop
JWT_EXPIRES_IN=15m
BCRYPT_COST=12

UPLOAD_MAX_BYTES=10485760
ORDER_PAYMENT_TIMEOUT=15m
IDEMPOTENCY_PROCESSING_TTL=30s
IDEMPOTENCY_RESULT_TTL=24h
IDEMPOTENCY_ALLOW_DEGRADED=true

